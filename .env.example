# Supabase — isi dari Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# Baru: sb_publishable_... | Lama: anon key (JWT) — salah satu aja cukup
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Jangan pernah tambah SERVICE_ROLE / SECRET di sini buat app ini (bypass RLS!)
